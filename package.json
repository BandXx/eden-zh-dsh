{
  "name": "eden-zh-dsh",
  "version": "1.2.0",
  "private": true,
  "description": "DeepSeek Harness bundle: one-click deploy the Simplified Chinese localization patch onto a local Eden.app on macOS.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "assets",
    "locale",
    "icon.svg",
    "README.md",
    "scripts"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "regress": "node scripts/regress.cjs"
  }
}